# Public links shown in the footer
REACT_APP_LINKEDIN_URL=https://www.linkedin.com/in/your-handle/
REACT_APP_GITHUB_URL=https://github.com/your-handle

# Optional project links
REACT_APP_PLEX_URL=
REACT_APP_DISCORD_INVITE=
REACT_APP_INDRA_URL=

# Optional. Leave unset to disable page tracking entirely.
REACT_APP_TRACK_URL=

# Optional. Leave unset to disable the Drishyam sign-in form.
REACT_APP_AUTH_URL=

# Optional. Leave unset to disable the Drishyam library calls.
REACT_APP_DRISHYAM_API=

# Never put secrets in this file. Anything prefixed REACT_APP_ is compiled
# into the public JS bundle and is readable by anyone who visits the site.
